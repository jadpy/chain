-- PLAYER ESP
local PlayerESPToggle = Tabs.Visual:AddToggle("PlayerESP", { Title = "Player Esp", Default = false })
local playerEspRunning = false
local playerESP = {}

PlayerESPToggle:OnChanged(function()
    playerEspRunning = PlayerESPToggle.Value
    if playerEspRunning then
        local LocalPlayer = Players.LocalPlayer
        local green = Color3.fromRGB(0, 200, 0)

        local function removeESP(player)
            if playerESP[player] then
                for _, object in ipairs(playerESP[player]) do
                    if object and object.Parent then object:Destroy() end
                end
                playerESP[player] = nil
            end
        end

        local function createESP(player)
            if player == LocalPlayer or not playerEspRunning then return end
            local function setup(character)
                if not playerEspRunning or not character.Parent then return end
                removeESP(player)
                local root = character:WaitForChild("HumanoidRootPart", 5)
                local humanoid = character:WaitForChild("Humanoid", 5)
                if not root or not humanoid then return end

                local highlight = Instance.new("Highlight")
                highlight.FillColor = green
                highlight.OutlineColor = green
                highlight.FillTransparency = 0.45
                highlight.OutlineTransparency = 0
                highlight.Adornee = character
                highlight.Parent = character

                local gui = Instance.new("BillboardGui")
                gui.Size = UDim2.new(0, 180, 0, 45)
                gui.StudsOffset = Vector3.new(0, 3, 0)
                gui.AlwaysOnTop = true
                gui.Adornee = root
                gui.Parent = character

                local label = Instance.new("TextLabel")
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.TextColor3 = green
                label.TextStrokeTransparency = 0
                label.TextSize = 12
                label.Font = Enum.Font.GothamBold
                label.Parent = gui

                playerESP[player] = {highlight, gui}

                task.spawn(function()
                    while playerEspRunning and character.Parent and player.Parent
                        and playerESP[player] and playerESP[player][1] == highlight do
                        local myChar = LocalPlayer.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if myRoot then
                            local dist = math.floor((myRoot.Position - root.Position).Magnitude + 0.5)
                            local hp = math.floor(humanoid.Health + 0.5)
                            label.Text = player.Name .. "\n" .. dist .. " studs | HP " .. hp
                        end
                        task.wait(0.05)
                    end
                end)
            end

            if player.Character then setup(player.Character) end
            player.CharacterAdded:Connect(function(character)
                if playerEspRunning then task.wait(0.3) setup(character) end
            end)
        end

        for _, player in ipairs(Players:GetPlayers()) do createESP(player) end
        Players.PlayerAdded:Connect(function(player)
            if playerEspRunning then createESP(player) end
        end)
    else
        for player, objects in pairs(playerESP) do
            for _, object in ipairs(objects) do
                if object and object.Parent then object:Destroy() end
            end
        end
        table.clear(playerESP)
    end
end)
PlayerESPToggle:SetValue(false)

