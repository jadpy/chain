-- DELETE CONFIG
Tabs.Settings:AddButton({
    Title = "Delete Config",
    Callback = function()
        local name = nil

        pcall(function()
            if SaveManager then
                name = SaveManager.SelectedConfigName
                    or SaveManager.ConfigName
                    or (SaveManager.Configs and SaveManager.SelectedConfig)
            end
        end)

        if not name or name == "" then
            pcall(function()
                if Fluent.Options then
                    for optId, opt in pairs(Fluent.Options) do
                        if optId:lower():find("configname") or optId:lower():find("name") then
                            if opt and opt.Value and opt.Value ~= "" then
                                name = opt.Value
                                break
                            end
                        end
                    end
                end
            end)
        end

        if not name or name == "" then
            Fluent:Notify({ Title = "Config Manager", Content = "Select a config in Config List first.", Duration = 4 })
            return
        end

        name = tostring(name):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then
            Fluent:Notify({ Title = "Config Manager", Content = "Invalid config name.", Duration = 4 })
            return
        end

        local candidates = {
            "DarkHub/" .. name .. ".json",
            "DarkHub/" .. name,
            "DarkHub/chain/" .. name .. ".json",
            "DarkHub/chain/" .. name,
            "DarkHub/Configs/" .. name .. ".json",
            "DarkHub/Configs/" .. name,
            "FluentScriptHub/" .. name .. ".json",
            "FluentScriptHub/specific-game/" .. name .. ".json",
            "FluentScriptHub/specific-game/" .. name,
        }

        local deleted = false

        for _, path in ipairs(candidates) do
            pcall(function()
                if isfile and isfile(path) then
                    delfile(path)
                    print("[DeleteConfig] Removed: " .. path)
                    deleted = true
                end
            end)
        end

        pcall(function()
            if isfolder and listfiles then
                for _, folder in ipairs({
                    "DarkHub",
                    "DarkHub/chain",
                    "DarkHub/Configs",
                    "FluentScriptHub",
                    "FluentScriptHub/specific-game"
                }) do
                    if isfolder(folder) then
                        for _, file in ipairs(listfiles(folder)) do
                            local fileName = file:match("([^/\\]+)$") or file
                            local baseName = fileName:gsub("%.json$", ""):gsub("%.txt$", "")
                            if baseName == name or fileName == name or fileName == name .. ".json" then
                                pcall(delfile, file)
                                print("[DeleteConfig] Removed: " .. file)
                                deleted = true
                            end
                        end
                    end
                end
            end
        end)

        if deleted then
            pcall(function()
                if SaveManager and SaveManager.RefreshConfigList then
                    SaveManager:RefreshConfigList()
                end
            end)

            Fluent:Notify({ Title = "Config Manager", Content = "Deleted: " .. name, Duration = 4 })
        else
            Fluent:Notify({ Title = "Config Manager", Content = "Config not found: " .. name, Duration = 4 })
        end
    end
})

