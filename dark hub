local AutoSlamToggle = Tabs.Combat:AddToggle("AutoSlam", { Title = "Auto Groundslam Dodge", Default = false })

do
    local Workspace = game:GetService("Workspace")
    local lp = Players.LocalPlayer
    local conns = {}
    local slamArmed = {}
    local SLAM_THRESHOLD = 70

    local function findSafeSpot(pos, avoid)
        local char = lp.Character
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = { char, avoid }
        local best, bestDist = nil, -1e9
        for _, radius in ipairs({12, 20, 30}) do
            for deg = 0, 315, 45 do
                local offset = Vector3.new(math.cos(math.rad(deg)) * radius, 0, math.sin(math.rad(deg)) * radius)
                local hit = Workspace:Raycast(pos + offset + Vector3.new(0, 50, 0), Vector3.new(0, -100, 0), rp)
                if hit then
                    local upBlocked = Workspace:Raycast(hit.Position + Vector3.new(0, 1, 0), Vector3.new(0, 16, 0), rp)
                    if not upBlocked then
                        local d = avoid and (hit.Position - avoid.Position).Magnitude or 999
                        if d > bestDist then bestDist = d best = hit.Position end
                    end
                end
            end
        end
        return best
    end

    local function onBurstChanged(chainModel)
        return function()
            if not AutoSlamToggle.Value then return end
            local burst = chainModel:GetAttribute("Burst")
            if not burst then return end
            if burst >= SLAM_THRESHOLD then slamArmed[chainModel] = true return end
            if not slamArmed[chainModel] then return end
            slamArmed[chainModel] = false
            local char = lp.Character
            local myHRP = char and char:FindFirstChild("HumanoidRootPart")
            local chainHRP = chainModel:FindFirstChild("HumanoidRootPart")
            if not myHRP or not chainHRP then return end
            if (myHRP.Position - chainHRP.Position).Magnitude > 45 then return end
            local safe = findSafeSpot(myHRP.Position, chainHRP)
            if safe then
                myHRP.CFrame = CFrame.new(safe + Vector3.new(0, 5, 0))
            else
                local away = (myHRP.Position - chainHRP.Position)
                away = Vector3.new(away.X, 0, away.Z)
                local dir = away.Magnitude > 0.5 and away.Unit or myHRP.CFrame.LookVector
                myHRP.CFrame = CFrame.new(myHRP.Position + dir * 30 + Vector3.new(0, 5, 0))
            end
        end
    end

    local function clearConns()
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
        slamArmed = {}
    end

    local function hookChain(model)
        if not model:IsA("Model") then return end
        if not model:FindFirstChild("HumanoidRootPart") then return end
        table.insert(conns, model:GetAttributeChangedSignal("Burst"):Connect(onBurstChanged(model)))
    end

    local function watchAI()
        local misc = Workspace:FindFirstChild("Misc")
        local ai = misc and misc:FindFirstChild("AI")
        if not ai then
            task.wait(1)
            if AutoSlamToggle.Value then watchAI() end
            return
        end
        for _, child in ipairs(ai:GetChildren()) do hookChain(child) end
        table.insert(conns, ai.ChildAdded:Connect(function(child)
            if AutoSlamToggle.Value then task.defer(hookChain, child) end
        end))
    end

    AutoSlamToggle:OnChanged(function()
        clearConns()
        if AutoSlamToggle.Value then task.spawn(watchAI) end
    end)
end
AutoSlamToggle:SetValue(false)

local ChainDamageToggle = Tabs.Combat:AddToggle("ChainDamage", { Title = "Auto Shoot", Default = false })

do
    local RS = game:GetService("ReplicatedStorage")
    local LP = Players.LocalPlayer
    local unpack = table.unpack or unpack

    local CONFIG = {
        weapon = "AK47", hitPart = "Head", baseDamage = 20, packetDamage = 20,
        spread = 0, distance = 157, interval = 0
    }
    local PRESETS = { AK47 = true, DoubleBarrel = true, Deagle = true, M1911 = true }
    local state = { loop = nil }

    local function getInventoryFolder()
        local pg = LP:FindFirstChild("PlayerGui")
        local ing = pg and pg:FindFirstChild("Ingame")
        return ing and ing:FindFirstChild("Inventory")
    end

    local function hasWeaponInInventory(name)
        if type(name) ~= "string" or not PRESETS[name] then return false end
        local inv = getInventoryFolder()
        if not inv then return false end
        for _, c in ipairs(inv:GetChildren()) do
            if c:IsA("ImageLabel") then
                local v = c:FindFirstChild("Values")
                local n = v and v:FindFirstChild("ItemName")
                if n and n.Value == name then return true end
            end
        end
        return false
    end

    local function isWeaponInHands()
        local w = CONFIG.weapon
        local char = LP.Character
        if not char then return false end
        local handler = char:FindFirstChild("CharacterHandler")
        local contents = handler and handler:FindFirstChild("Contents")
        local values = contents and contents:FindFirstChild("Values")
        local eq = values and values:FindFirstChild("Equipped")
        if eq and eq:IsA("BoolValue") and eq.Value ~= true then return false end
        local names = {w}
        if w == "Deagle" then names[#names+1] = "DesertEagle" end
        local strg = char:FindFirstChild("STRG_")
        for _, n in ipairs(names) do
            if char:FindFirstChild(n) then return true end
            if strg and strg:FindFirstChild(n) then return true end
        end
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") and (c.Name == w or (w == "Deagle" and c.Name == "DesertEagle")) then return true end
        end
        return false
    end

    local function findChain()
        local misc = workspace:FindFirstChild("Misc")
        local ai = misc and misc:FindFirstChild("AI")
        if not ai then return nil end
        local named = ai:FindFirstChild("CHAIN") or ai:FindFirstChild("Chain")
        if named then return named end
        for _, c in ipairs(ai:GetChildren()) do
            if c:FindFirstChild("HumanoidRootPart") and string.find(string.lower(c.Name), "chain", 1, true) then
                return c
            end
        end
    end

    local function getSettings()
        local ii = RS:FindFirstChild("GameStuff")
        ii = ii and ii:FindFirstChild("ItemInfo")
        local gun = ii and ii:FindFirstChild(CONFIG.weapon)
        if not gun then return nil, nil end
        local setting = gun:FindFirstChild("Setting")
        if not setting then return nil, gun end
        local ok, result = pcall(require, setting)
        if not ok or type(result) ~= "table" then return nil, gun end
        local s = {}
        for k, v in pairs(result) do s[k] = v end
        s.BaseDamage = CONFIG.baseDamage
        s.Spread = CONFIG.spread
        return s, gun
    end

    local function prepare()
        if not hasWeaponInInventory(CONFIG.weapon) then return nil, nil end
        if not isWeaponInHands() then return nil, nil end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil, nil end
        local chain = findChain()
        if not chain then return nil, nil end
        local hum = chain:FindFirstChildOfClass("Humanoid")
        local chainHrp = chain:FindFirstChild("HumanoidRootPart")
        local target = chain:FindFirstChild(CONFIG.hitPart) or chain:FindFirstChild("Head")
            or chain:FindFirstChild("UpperTorso") or chain:FindFirstChild("Torso") or chainHrp
        if not hum or not chainHrp or not target then return nil, nil end
        local settings, gun = getSettings()
        if not settings or not gun then return nil, nil end
        local remotes = RS:FindFirstChild("GameStuff")
        remotes = remotes and remotes:FindFirstChild("Remotes")
        local inflict = remotes and remotes:FindFirstChild("InflictTarget")
        if not inflict then return nil, nil end
        local dist = CONFIG.distance
        if dist <= 0 then dist = (hrp.Position - target.Position).Magnitude end
        local gore = gun:FindFirstChild("GoreEffect")
        return inflict, {
            [1] = settings, [2] = hrp, [3] = LP, [4] = hum, [5] = chainHrp,
            [6] = {CONFIG.packetDamage, 2, true, dist, false, 10000, 1000},
            [7] = {0, 0, false, "", 100},
            [8] = {false, 5, 3},
            [9] = target,
            [10] = {false, {1930359546}, 1, 1.5, 1, gore, 50}
        }
    end

    local function fireOnce()
        local remote, args = prepare()
        if not remote then return false end
        pcall(function() remote:InvokeServer(unpack(args, 1, 10)) end)
        return true
    end

    local function stopAuto()
        if state.loop then pcall(task.cancel, state.loop) state.loop = nil end
    end

    ChainDamageToggle:OnChanged(function()
        ChainDamageEnabled = ChainDamageToggle.Value == true
        if ChainDamageEnabled then
            if not hasWeaponInInventory(CONFIG.weapon) then ChainDamageEnabled = false return end
            if not isWeaponInHands() then ChainDamageEnabled = false return end
            stopAuto()
            state.loop = task.spawn(function()
                while ChainDamageEnabled do
                    if not isWeaponInHands() then ChainDamageEnabled = false return end
                    fireOnce()
                    task.wait()
                end
            end)
        else
            stopAuto()
        end
    end)
end

local AutoQTEToggle = Tabs.Combat:AddToggle("AutoQTE", { Title = "Auto QTE", Default = false })

do
    local autoQTEEnabled = false
    local qteThreads, qteStopFlags, qteSetupDone = {}, {}, {}
    local INITIAL_DELAY, SPAM_INTERVAL, HOLD_TIME = 0.09, 0.03, 0.01
    local VIM = game:GetService("VirtualInputManager")
    local LP = Players.LocalPlayer

    local function getKeyCodeLocal(key)
        if type(key) ~= "string" then return end
        local cleaned = key:gsub("%s+", "")
        if cleaned == "" then return end
        return Enum.KeyCode[cleaned:upper()]
    end

    local function pressKeyOnce(k)
        VIM:SendKeyEvent(true, k, false, game)
        task.wait(HOLD_TIME)
        VIM:SendKeyEvent(false, k, false, game)
    end

    local function stopQTEThread(id)
        if not qteThreads[id] then return end
        qteStopFlags[id] = true
        pcall(task.cancel, qteThreads[id])
        qteThreads[id] = nil
        qteStopFlags[id] = false
    end

    local function startSpamForContainer(frame, id)
        stopQTEThread(id)
        if not autoQTEEnabled or not frame or not frame:IsA("GuiObject") or not frame.Visible then return end
        local PC = frame:FindFirstChild("PC", true)
        if not PC or not PC:IsA("TextLabel") then return end
        local kc = getKeyCodeLocal(PC.Text)
        if not kc then return end
        qteStopFlags[id] = false
        qteThreads[id] = task.spawn(function()
            task.wait(INITIAL_DELAY)
            if not frame.Visible or getKeyCodeLocal(PC.Text) ~= kc then return end
            while not qteStopFlags[id] and frame.Visible and autoQTEEnabled do
                pressKeyOnce(kc)
                task.wait(SPAM_INTERVAL)
                if getKeyCodeLocal(PC.Text) ~= kc then break end
            end
            qteThreads[id] = nil
        end)
    end

    local function setupQTELocal(frame, id)
        if qteSetupDone[id] or not frame:IsA("GuiObject") then return end
        local PC = frame:FindFirstChild("PC", true)
        if not PC or not PC:IsA("TextLabel") then return end
        qteSetupDone[id] = true
        local function onUpdate()
            if not autoQTEEnabled or not frame.Visible or PC.Text == "" then stopQTEThread(id) return end
            if getKeyCodeLocal(PC.Text) then startSpamForContainer(frame, id) else stopQTEThread(id) end
        end
        PC:GetPropertyChangedSignal("Text"):Connect(onUpdate)
        frame:GetPropertyChangedSignal("Visible"):Connect(onUpdate)
        onUpdate()
    end

    local function initQTELocal()
        local pg = LP:FindFirstChild("PlayerGui")
        if not pg then return end
        local MechanicsFrame
        for _, gui in ipairs(pg:GetChildren()) do
            MechanicsFrame = gui:FindFirstChild("MechanicsFrame")
            if MechanicsFrame then break end
        end
        if not MechanicsFrame then return end
        for _, name in ipairs({"QTE", "QTEToma", "QTEXSaw"}) do
            local f = MechanicsFrame:FindFirstChild(name)
            if f then setupQTELocal(f, name) end
        end
    end

    local function stopAllQTELocal()
        for k in pairs(qteThreads) do stopQTEThread(k) end
    end

    local function resetAndInit()
        if not autoQTEEnabled then return end
        qteSetupDone = {}
        stopAllQTELocal()
        task.wait(0.5)
        initQTELocal()
    end

    LP.CharacterAdded:Connect(function() task.defer(resetAndInit) end)
    LP:WaitForChild("PlayerGui").ChildAdded:Connect(function(child)
        if child:FindFirstChild("MechanicsFrame") then
            task.wait(0.3)
            if autoQTEEnabled then initQTELocal() end
        end
    end)

    AutoQTEToggle:OnChanged(function()
        if AutoQTEToggle.Value then autoQTEEnabled = true initQTELocal()
        else autoQTEEnabled = false stopAllQTELocal() end
    end)
end

