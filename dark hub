-- SCRAP ESP
local ScrapESPToggle = Tabs.Visual:AddToggle("ScrapESP", { Title = "Scrap Esp", Default = false })

local player = Players.LocalPlayer
local scrapFolder = workspace.Misc.Zones.LootingItems:WaitForChild("Scrap")

local scrapEspRunning = false
local scrapConnections = {}
local scrapLabels = {}
local scrapHighlights = {}
local scrapGui
local blue = Color3.fromRGB(0, 130, 160)

local function getAvailable(scrap)
    local values = scrap:FindFirstChild("Values")
    if not values then return false end
    return values:GetAttribute("Available")
end

local function removeScrap(scrap)
    if scrapLabels[scrap] then scrapLabels[scrap]:Destroy() scrapLabels[scrap] = nil end
    if scrapHighlights[scrap] then scrapHighlights[scrap]:Destroy() scrapHighlights[scrap] = nil end
end

local function addScrap(scrap)
    if not scrapEspRunning or scrapLabels[scrap] then return end
    if scrap:GetAttribute("Scrap") == nil then return end
    if not scrap:FindFirstChild("Values") then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = blue
    highlight.OutlineColor = blue
    highlight.FillTransparency = 0.45
    highlight.OutlineTransparency = 0
    highlight.Adornee = scrap
    highlight.Enabled = false
    highlight.Parent = scrap
    scrapHighlights[scrap] = highlight

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 120, 0, 35)
    label.AnchorPoint = Vector2.new(0.5, 0.5)
    label.BackgroundTransparency = 1
    label.TextColor3 = blue
    label.TextStrokeTransparency = 0
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Visible = false
    label.Parent = scrapGui
    scrapLabels[scrap] = label
end

ScrapESPToggle:OnChanged(function()
    if ScrapESPToggle.Value then
        if scrapEspRunning then return end
        scrapEspRunning = true
        scrapGui = Instance.new("ScreenGui")
        scrapGui.IgnoreGuiInset = true
        scrapGui.DisplayOrder = 10
        scrapGui.Parent = CoreGui

        for _, scrap in ipairs(scrapFolder:GetChildren()) do addScrap(scrap) end

        scrapConnections.added = scrapFolder.ChildAdded:Connect(function(scrap)
            task.defer(function() if scrapEspRunning then addScrap(scrap) end end)
        end)
        scrapConnections.removed = scrapFolder.ChildRemoved:Connect(function(scrap) removeScrap(scrap) end)

        scrapConnections.render = RunService.RenderStepped:Connect(function()
            if not scrapEspRunning then return end
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local camera = workspace.CurrentCamera
            if not root or not camera then return end

            for scrap, label in pairs(scrapLabels) do
                if not scrap.Parent then removeScrap(scrap) continue end
                local highlight = scrapHighlights[scrap]
                local available = getAvailable(scrap)
                if not available then
                    label.Visible = false
                    if highlight then highlight.Enabled = false end
                    continue
                end

                local success, pivot = pcall(function() return scrap:GetPivot() end)
                if not success then
                    label.Visible = false
                    if highlight then highlight.Enabled = false end
                    continue
                end

                local position, visible = camera:WorldToViewportPoint(pivot.Position)
                if visible then
                    local distance = math.floor((root.Position - pivot.Position).Magnitude + 0.5)
                    label.Text = "Scrap\n" .. distance .. " studs"
                    label.Position = UDim2.fromOffset(position.X, position.Y)
                    label.Visible = true
                    if highlight then highlight.Enabled = true end
                else
                    label.Visible = false
                    if highlight then highlight.Enabled = false end
                end
            end
        end)
    else
        scrapEspRunning = false
        for _, connection in pairs(scrapConnections) do
            if typeof(connection) == "RBXScriptConnection" then connection:Disconnect() end
        end
        table.clear(scrapConnections)
        for scrap, label in pairs(scrapLabels) do if label then label:Destroy() end end
        for scrap, highlight in pairs(scrapHighlights) do if highlight then highlight:Destroy() end end
        table.clear(scrapLabels)
        table.clear(scrapHighlights)
        if scrapGui then scrapGui:Destroy() scrapGui = nil end
    end
end)
ScrapESPToggle:SetValue(false)

