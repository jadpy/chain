local NoRecoilToggle = Tabs.Combat:AddToggle("NoRecoil", { Title = "No Recoil", Default = false })

do
    local LP = Players.LocalPlayer
    local noRecoil = { enabled = false, charConn = nil, loop = nil }
    local RECOIL_FUNCS = {"DeagleRecoil","DBRecoil","AKRecoil","M1911Recoil"}

    local function killRecoil()
        local char = LP.Character
        local handler = char and char:FindFirstChild("CharacterHandler")
        if not handler then return false end
        local killed = false
        if type(getsenv) == "function" then
            local ok, env = pcall(getsenv, handler)
            if ok and type(env) == "table" then
                for i = 1, #RECOIL_FUNCS do
                    local key = RECOIL_FUNCS[i]
                    if type(env[key]) == "function" then env[key] = function() end killed = true end
                end
                for _, key in ipairs({"v3", "v4"}) do
                    local t = env[key]
                    if type(t) == "table" then
                        pcall(function()
                            if t.p then t.p = Vector3.zero end
                            if t.v then t.v = Vector3.zero end
                            if type(t.accelerate) == "function" then t.accelerate = function() end end
                        end)
                    end
                end
            end
        end
        return killed
    end

    local function setEnabled(state)
        noRecoil.enabled = state == true
        if noRecoil.loop then pcall(task.cancel, noRecoil.loop) noRecoil.loop = nil end
        if not noRecoil.enabled then return end
        killRecoil()
        noRecoil.loop = task.spawn(function()
            while noRecoil.enabled do killRecoil() task.wait(2) end
            noRecoil.loop = nil
        end)
        if not noRecoil.charConn then
            noRecoil.charConn = LP.CharacterAdded:Connect(function(char)
                if not noRecoil.enabled then return end
                task.spawn(function()
                    char:WaitForChild("CharacterHandler", 10)
                    task.wait(0.3)
                    if noRecoil.enabled then killRecoil() end
                end)
            end)
        end
    end

    NoRecoilToggle:OnChanged(function() setEnabled(NoRecoilToggle.Value) end)
end

