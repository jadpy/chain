local AimbotToggle = Tabs.Player:AddToggle("ChainAimbot", { Title = "Aimbot", Default = false })

do
    local Workspace = game:GetService("Workspace")
    local UserInputService = game:GetService("UserInputService")
    local Camera = Workspace.CurrentCamera
    local AIFolder = Workspace:WaitForChild("Misc"):WaitForChild("AI")

    local AimbotEnabled = false
    local RightMouseDown = false
    local CHAIN

    local function lookAt(targetCFrame)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetCFrame.Position)
    end

    local function getChain()
        if CHAIN and CHAIN.Parent then return CHAIN end
        for _, child in ipairs(AIFolder:GetChildren()) do
            if child:FindFirstChild("HumanoidRootPart") then return child end
        end
        return nil
    end

    local function onRender()
        if AimbotEnabled and RightMouseDown then
            CHAIN = getChain()
            if CHAIN then lookAt(CHAIN:GetPivot()) end
        else
            CHAIN = nil
        end
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            RightMouseDown = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            RightMouseDown = false
        end
    end)

    RunService.RenderStepped:Connect(onRender)

    AimbotToggle:OnChanged(function()
        AimbotEnabled = AimbotToggle.Value == true
    end)
end

local PerfBoosterToggle = Tabs.Player:AddToggle("PerformanceBooster", { Title = "Performance Booster", Default = false })

do
    local Lighting = game:GetService("Lighting")
    local UserGameSettings = UserSettings():GetService("UserGameSettings")

    local originalSettings = {}
    local settingsSaved = false

    local function saveOriginalSettings()
        if settingsSaved then return end
        originalSettings.Technology = Lighting.Technology
        originalSettings.GlobalShadows = Lighting.GlobalShadows
        originalSettings.FogEnd = Lighting.FogEnd
        originalSettings.QualityLevel = UserGameSettings.SavedQualityLevel
        originalSettings.effects = {}
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then
                originalSettings.effects[effect] = effect.Enabled
            end
        end
        settingsSaved = true
    end

    local function applyPerformanceMode()
        saveOriginalSettings()
        Lighting.Technology = Enum.Technology.Compatibility
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        UserGameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then
                effect.Enabled = false
            end
        end
    end

    local function restoreOriginalSettings()
        if not settingsSaved then return end
        Lighting.Technology = originalSettings.Technology
        Lighting.GlobalShadows = originalSettings.GlobalShadows
        Lighting.FogEnd = originalSettings.FogEnd
        UserGameSettings.SavedQualityLevel = originalSettings.QualityLevel
        for effect, wasEnabled in pairs(originalSettings.effects) do
            pcall(function()
                if effect and effect.Parent then
                    effect.Enabled = wasEnabled
                end
            end)
        end
    end

    PerfBoosterToggle:OnChanged(function()
        if PerfBoosterToggle.Value then
            applyPerformanceMode()
        else
            restoreOriginalSettings()
        end
    end)
end

local NoclipToggle = Tabs.Player:AddToggle("Noclip", { Title = "Noclip", Default = false })

do
    local LP = Players.LocalPlayer
    local noclipConn = nil
    local noclipActive = false

    local function stopNoclip()
        noclipActive = false
        if noclipConn then
            noclipConn:Disconnect()
            noclipConn = nil
        end
        local char = LP.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    pcall(function()
                        part.CanCollide = true
                        part.CanTouch = true
                    end)
                end
            end
        end
    end

    local function startNoclip()
        local char = LP.Character or LP.CharacterAdded:Wait()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        noclipActive = true
        hum.WalkSpeed = 0
        hum.JumpPower = 0

        if noclipConn then noclipConn:Disconnect() end
        noclipConn = RunService.Heartbeat:Connect(function()
            if not noclipActive then return end
            local c = LP.Character
            if not c then return end
            for _, part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                    part.CanTouch = false
                end
            end
        end)
    end

    NoclipToggle:OnChanged(function()
        if NoclipToggle.Value then
            startNoclip()
        else
            stopNoclip()
        end
    end)

    LP.CharacterAdded:Connect(function()
        if noclipActive then
            task.wait(0.5)
            startNoclip()
        end
    end)

    NoclipToggle:SetValue(false)
end

-- UNLOCK JUMP
local UnlockJumpToggle = Tabs.Player:AddToggle("UnlockJump", { Title = "Unlock Jump", Default = false })

do
    local LP = Players.LocalPlayer
    local heartbeatConn = nil
    local stateConn = nil
    local animatorConn = nil

    local JUMP_STATE_TYPES = {
        Enum.HumanoidStateType.Jumping,
        Enum.HumanoidStateType.Freefall,
        Enum.HumanoidStateType.Landed,
    }

    local function fixHumanoid(hum)
        if not hum then return end
        pcall(function()
            if hum.UseJumpPower == false then hum.UseJumpPower = true end
            if hum.JumpPower ~= 50 then hum.JumpPower = 50 end
            if hum.JumpHeight ~= 7.2 then hum.JumpHeight = 7.2 end

            for _, state in ipairs(JUMP_STATE_TYPES) do
                if hum:GetStateEnabled(state) == false then
                    hum:SetStateEnabled(state, true)
                end
            end
        end)
    end

    local function stopUnlockJump()
        if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
        if stateConn then stateConn:Disconnect() stateConn = nil end
        if animatorConn then animatorConn:Disconnect() animatorConn = nil end

        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.JumpPower = 0
                hum.JumpHeight = 0
                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
                hum:SetStateEnabled(Enum.HumanoidStateType.Landed, false)
            end)
        end
    end

    local function startUnlockJump()
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        fixHumanoid(hum)

        if heartbeatConn then heartbeatConn:Disconnect() end
        heartbeatConn = RunService.Heartbeat:Connect(function()
            if not UnlockJumpToggle.Value then return end
            local c = LP.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            if not h then return end

            local needsFix = false
            if h.UseJumpPower == false then needsFix = true end
            if h.JumpPower ~= 50 then needsFix = true end
            if h.JumpHeight ~= 7.2 then needsFix = true end
            if h:GetStateEnabled(Enum.HumanoidStateType.Jumping) == false then needsFix = true end

            if needsFix then
                fixHumanoid(h)
            end
        end)

        if stateConn then stateConn:Disconnect() end
        if hum then
            stateConn = hum.StateChanged:Connect(function(_, newState)
                if not UnlockJumpToggle.Value then return end
                if newState == Enum.HumanoidStateType.Jumping
                    or newState == Enum.HumanoidStateType.Freefall
                    or newState == Enum.HumanoidStateType.Landed then
                    if hum:GetStateEnabled(newState) == false then
                        hum:SetStateEnabled(newState, true)
                    end
                end
            end)
        end

        if animatorConn then animatorConn:Disconnect() end
        animatorConn = LP.CharacterAdded:Connect(function(newChar)
            task.wait(0.5)
            if UnlockJumpToggle.Value then
                local newHum = newChar:WaitForChild("Humanoid", 5)
                if newHum then
                    fixHumanoid(newHum)
                    if stateConn then stateConn:Disconnect() end
                    stateConn = newHum.StateChanged:Connect(function(_, newState)
                        if not UnlockJumpToggle.Value then return end
                        if newState == Enum.HumanoidStateType.Jumping
                            or newState == Enum.HumanoidStateType.Freefall
                            or newState == Enum.HumanoidStateType.Landed then
                            if newHum:GetStateEnabled(newState) == false then
                                newHum:SetStateEnabled(newState, true)
                            end
                        end
                    end)
                end
            end
        end)
    end

    UnlockJumpToggle:OnChanged(function()
        if UnlockJumpToggle.Value then
            startUnlockJump()
        else
            stopUnlockJump()
        end
    end)

    UnlockJumpToggle:SetValue(false)
end

local NoSlowToggle = Tabs.Player:AddToggle("NoSlow", { Title = "No Slowdown", Default = false })

do
    local RS = game:GetService("ReplicatedStorage")
    local LP = Players.LocalPlayer
    local conn = nil

    local function getVelocity()
        local assets = RS:FindFirstChild("Assets")
        local client = assets and assets:FindFirstChild("Client")
        local movement = client and client:FindFirstChild("Movement")
        return movement and movement:FindFirstChild("Velocity")
    end

    local function getWalkSpeed()
        local char = LP.Character
        local stats = char and char:FindFirstChild("Stats")
        return stats and stats:FindFirstChild("WalkSpeed")
    end

    local function setEnabled(state)
        if conn then conn:Disconnect() conn = nil end
        if not state then return end
        conn = RunService.RenderStepped:Connect(function()
            local vel = getVelocity()
            if vel and vel.Value < 12 then vel.Value = 12 end
            local ws = getWalkSpeed()
            if ws and ws.Value < 12 then ws.Value = 12 end
        end)
    end

    NoSlowToggle:OnChanged(function() setEnabled(NoSlowToggle.Value) end)
    LP.CharacterAdded:Connect(function()
        if NoSlowToggle.Value then task.wait(0.5) setEnabled(true) end
    end)
end

local HitboxExpanderToggle = Tabs.Player:AddToggle("ChainHitbox", { Title = "Chain Hitbox Expander", Default = false })

do
    local Workspace = game:GetService("Workspace")
    local conn = nil
    local originalSize, originalTransparency, originalCanCollide, originalCanQuery, originalCanTouch, trackedHRP

    local function getChain()
        local misc = Workspace:FindFirstChild("Misc")
        local ai = misc and misc:FindFirstChild("AI")
        return ai and ai:FindFirstChild("CHAIN")
    end

    local function expandChain()
        local chain = getChain()
        if not chain then return end
        local hrp = chain:IsA("BasePart") and chain or chain:FindFirstChild("HumanoidRootPart", true)
            or chain:FindFirstChildWhichIsA("BasePart", true)
        if not hrp then return end
        if trackedHRP ~= hrp then
            trackedHRP = hrp
            originalSize = hrp.Size
            originalTransparency = hrp.Transparency
            originalCanCollide = hrp.CanCollide
            originalCanQuery = hrp.CanQuery
            originalCanTouch = hrp.CanTouch
        end
        hrp.Size = Vector3.new(10000, 10000, 10000)
        hrp.Transparency = 1
        hrp.CanCollide = false
        hrp.CanQuery = false
        hrp.CanTouch = false
    end

    local function restoreChain()
        if trackedHRP and trackedHRP.Parent then
            trackedHRP.Size = originalSize or trackedHRP.Size
            trackedHRP.Transparency = originalTransparency or 0
            trackedHRP.CanCollide = originalCanCollide
            trackedHRP.CanQuery = originalCanQuery
            trackedHRP.CanTouch = originalCanTouch
        end
        trackedHRP = nil
        originalSize, originalTransparency, originalCanCollide, originalCanQuery, originalCanTouch = nil, nil, nil, nil, nil
    end

    HitboxExpanderToggle:OnChanged(function()
        if conn then conn:Disconnect() conn = nil end
        if HitboxExpanderToggle.Value then
            conn = RunService.Heartbeat:Connect(function()
                if HitboxExpanderToggle.Value then expandChain() end
            end)
        else
            restoreChain()
        end
    end)
end
HitboxExpanderToggle:SetValue(false)

local InstantRespawnToggle = Tabs.Player:AddToggle("InstantRespawn", { Title = "Instant Respawn", Default = false })

do
    local RS = game:GetService("ReplicatedStorage")
    local LP = Players.LocalPlayer
    local conn = nil

    local function getGameEvent()
        local gs = RS:FindFirstChild("GameStuff")
        local remotes = gs and gs:FindFirstChild("Remotes")
        return remotes and remotes:FindFirstChild("GameEvent")
    end

    local function doRespawn()
        local event = getGameEvent()
        if event then pcall(function() event:FireServer("Respawn") end) end
    end

    local function setEnabled(state)
        if conn then conn:Disconnect() conn = nil end
        if not state then return end
        conn = RunService.Heartbeat:Connect(function()
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then doRespawn() end
        end)
    end

    InstantRespawnToggle:OnChanged(function() setEnabled(InstantRespawnToggle.Value) end)
    LP.CharacterAdded:Connect(function()
        if InstantRespawnToggle.Value then task.wait(0.3) setEnabled(true) end
    end)
end
InstantRespawnToggle:SetValue(false)

